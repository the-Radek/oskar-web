# Modify to setup local development
# use `ports` to expose ports to host
# use `profiles` to disable service (unless explicitly enabled)
# use `volumes` to specify local data directory

services:
  db:
    ports:
      - 127.0.0.1:5432:5432
    volumes:
      - dbdata:/var/lib/postgresql/data
  adminer:
    image: ghcr.io/shyim/adminerevo
    depends_on:
      - db
    environment:
      ADMINER_DEFAULT_DRIVER: pgsql
      ADMINER_DEFAULT_SERVER: db
      ADMINER_DEFAULT_DB: oskar
      ADMINER_DEFAULT_USER: oskar
      ADMINER_DEFAULT_PASSWORD: *****
    ports:
      - "127.0.0.1:8080:8080"
