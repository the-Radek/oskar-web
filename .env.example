# This is an example of the .env file
# Server
HOST=localhost:3000
NAMESPACE=oskar
SESSION_PASSWORD_FILE=./secrets/session_password

# Database
DB_HOST=localhost
DB_USERNAME=oskar
DB_DATABASE=oskar
DB_PASSWORD_FILE=./secrets/db_password

# Google API
GOOGLE_CLIENT_ID=
GOOGLE_SECRET_FILE=./secrets/google_secret

# Docker
COMPOSE_PROFILES=dev
